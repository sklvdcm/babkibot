POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql+asyncpg://budget:change_me@db:5432/budget

# JSON object: stable Shortcut user ID -> a long random bearer token.
SHORTCUT_TOKENS={"daniil":"replace-with-at-least-32-random-characters"}
# Optional names shown in expense history.
SHORTCUT_USERS={"daniil":"Даниил"}

# Set both values only in the server .env. Never commit the real password or secret.
WEB_PASSWORD=replace_only_on_host
WEB_SESSION_SECRET=replace_with_openssl_rand_hex_32
COOKIE_SECURE=true

TIMEZONE=Europe/Moscow
LOG_LEVEL=INFO
